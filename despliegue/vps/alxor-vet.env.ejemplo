# Variables de entorno del servicio ALXOR Vet (SIN Docker).
# instalar.sh genera /etc/alxor-vet.env a partir de esto, rellenando la
# contraseña de la BD y el secreto JWT automáticamente. Este fichero es solo
# una referencia de las claves que se usan.

ASPNETCORE_ENVIRONMENT=Production
# La app escucha SOLO en local; Caddy (proxy) la publica con HTTPS al exterior.
ASPNETCORE_URLS=http://127.0.0.1:8080

# PostgreSQL local (instalado por apt). La contraseña la pone instalar.sh.
ConnectionStrings__AlxorCore=Host=127.0.0.1;Port=5432;Database=alxor;Username=alxor;Password=CAMBIA

# Secreto JWT (mínimo 32 caracteres). Lo genera instalar.sh.
Jwt__ClaveSecreta=CAMBIA_secreto_largo_y_aleatorio
Jwt__Emisor=alxor-vet
Jwt__Audiencia=alxor-vet
Jwt__MinutosExpiracion=60

# La app crea/migra el esquema sola al arrancar.
Migraciones__AplicarAlArrancar=true

# Correo SMTP (opcional). Para que los enlaces de los correos apunten a tu
# dominio público, pon aquí https://TU_DOMINIO.
Correo__Habilitado=false
Correo__Host=
Correo__Puerto=587
Correo__UsarStartTls=true
Correo__Usuario=
Correo__Clave=
Correo__Remitente=no-responder@alxor.local
Correo__RemitenteNombre=Clínica Veterinaria
Correo__BaseUrl=https://vet.tudominio.com
