# ALXOR Vet — configuración de la instalación de la clínica.
# Copia este fichero a «.env» (en la misma carpeta) y rellena los valores reales.
#   cp despliegue/.env.ejemplo despliegue/.env
# El fichero .env NO debe subirse a ningún repositorio: contiene secretos.

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
# Cambia esta contraseña por una robusta:
POSTGRES_PASSWORD=CAMBIA_esta_password_de_postgres
POSTGRES_DB=alxor

# ---------------------------------------------------------------------------
# Secreto JWT — OBLIGATORIO cambiarlo. Mínimo 32 caracteres, aleatorio.
# Genera uno, por ejemplo, con:  openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_CLAVE_SECRETA=CAMBIA_esto_por_un_secreto_largo_y_aleatorio_de_32+_caracteres

# Puerto en el que se publica la app en la red local de la clínica.
PUERTO_LAN=8080

# Entorno de ejecución (Development aplica migraciones solo y publica Swagger).
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# Correo SMTP de la clínica
#   Habilitado=true + Host relleno  ->  se envían correos de verdad.
#   Habilitado=false (o Host vacío) ->  no se envían correos (modo por defecto).
# Puerto 587 con STARTTLS es lo habitual (Gmail, dominios propios).
# En Gmail/Google Workspace usa una «contraseña de aplicación», no la del usuario.
# ---------------------------------------------------------------------------
CORREO_HABILITADO=false
CORREO_HOST=
CORREO_PUERTO=587
CORREO_STARTTLS=true
CORREO_USUARIO=
CORREO_CLAVE=
CORREO_REMITENTE=clinica@tudominio.com
CORREO_REMITENTE_NOMBRE=Clínica Veterinaria
# URL con la que se accede a la app (para los enlaces de los correos).
# Si expones la app a internet (ver Cloudflare Tunnel), pon aquí esa URL pública.
CORREO_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Recordatorios automáticos (opcional; desactivados por defecto)
#   Si se activan, una vez al día generan y envían por correo los recordatorios
#   de vacunas y revisiones próximas. Requiere el correo SMTP configurado.
# ---------------------------------------------------------------------------
RECORDATORIOS_AUTOMATICO=false
RECORDATORIOS_HORA=08:00
RECORDATORIOS_DIAS=30
